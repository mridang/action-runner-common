{
  "name": "@mridang/action-runner-common",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepack": "tsc",
    "build": "rollup --config=rollup.config.mjs",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:watch": "npm run test -- --watch",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix"
  },
  "main": "dist/main.cjs",
  "keywords": [
    "github-actions",
    "runner",
    "harden-runner",
    "docker-cache",
    "ci"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "Common first-step GitHub Action applied to every workflow — runner hardening (step-security/harden-runner) and Docker image layer caching (ScribeMD/docker-cache), pinned by full commit SHA.",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/action-runner-common.git"
  },
  "homepage": "https://github.com/mridang/action-runner-common",
  "bugs": "https://github.com/mridang/action-runner-common/issues",
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@jest/globals": "^30.0.0-beta.3",
    "@mridang/eslint-defaults": "^1.6.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.3",
    "semantic-release": "^25.0.8",
    "semantic-release-major-tag": "^0.3.2",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
